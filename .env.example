# ============================================================================
# DEJOIY AUTH — Environment Configuration Template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=dejoiy-auth
# Public base URL of the auth platform (used for links in emails, redirects)
APP_URL=http://localhost:8080
# Comma-separated list of origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Comma-separated list of admin bootstrap emails (first-run super admin)
BOOTSTRAP_ADMIN_EMAIL=deepak.sharma@dejoiy.com

# ---------------------------------------------------------------------------
# PostgreSQL (primary source of truth for identity)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://dejoiy_auth:change-me-strong-db-password@localhost:5432/dejoiy_auth

# ---------------------------------------------------------------------------
# Redis (rate limiting, throttling, short-lived tokens, distributed locks)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Secrets — generate strong random values, e.g. `openssl rand -hex 32`
# ---------------------------------------------------------------------------
# Signing key for access tokens (JWT HS256)
ACCESS_TOKEN_SECRET=change-me-access-token-secret-64-chars-min
# Signing key for refresh tokens (opaque tokens, signed envelope)
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-64-chars-min
# Encryption key for short-lived secrets (recovery codes, MFA, magic links)
DATA_ENCRYPTION_KEY=change-me-data-encryption-key-64-chars-min
# First-run super admin bootstrap secret (used only during initial setup)
BOOTSTRAP_SECRET=change-me-bootstrap-secret
# Cookie signing secret
COOKIE_SECRET=change-me-cookie-secret-32-chars-min

# ---------------------------------------------------------------------------
# Session / tokens
# ---------------------------------------------------------------------------
# Access token lifetime (seconds). Default 15 minutes.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime (seconds). Default 30 days.
REFRESH_TOKEN_TTL_SECONDS=2592000
# Session idle timeout (seconds). Default 12 hours.
SESSION_IDLE_TTL_SECONDS=43200
# Absolute session lifetime (seconds). Default 30 days.
SESSION_ABSOLUTE_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# Password policy
# ---------------------------------------------------------------------------
PASSWORD_MIN_LENGTH=14
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
# Number of previous passwords to remember (reuse prevention)
PASSWORD_HISTORY_LIMIT=10
# Require stronger policy for privileged roles (SUPER_ADMIN, IT_ADMIN, SECURITY_ADMIN, AUDITOR)
PRIVILEGED_ROLES=SUPER_ADMIN,IT_ADMIN,SECURITY_ADMIN,AUDITOR

# ---------------------------------------------------------------------------
# Login throttling / brute-force protection
# ---------------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_DURATION_SECONDS=900
# Progressive per-IP delay (ms per failed attempt step)
LOGIN_PROGRESSIVE_DELAY_STEP_MS=400
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=30

# ---------------------------------------------------------------------------
# Mail / notifications
# Provider options: console | smtp | dejoiy-swiss | ses
# ---------------------------------------------------------------------------
MAIL_PROVIDER=dejoiy-swiss
# Use the "Name <address>" form so the provider renders a friendly sender
MAIL_FROM=DEJOIY <noreply@dejoiy.com>
MAIL_ERRORS_FROM=DEJOIY <errors@dejoiy.com>
# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# DEJOIY Swiss Mail API — POST {url}/v1/emails with Authorization: Bearer {key}
DEJOIY_MAIL_API_URL=https://api-mail.dejoiy.com
DEJOIY_MAIL_API_KEY=
# AWS SES
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Zoho Sheet synchronization
# ---------------------------------------------------------------------------
# OAuth client for Zoho (Zoho API console). Credentials stay server-side only.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_SHEET_URL=https://sheet.zoho.in/sheet/open/t9x1641aa584211e6448798bfad7f1037c8d6
ZOHO_SYNC_INTERVAL_SECONDS=3600

# ---------------------------------------------------------------------------
# OIDC / OAuth
# ---------------------------------------------------------------------------
# Issuer identifier used in the OIDC discovery document
OIDC_ISSUER_URL=http://localhost:8080
# Default lifetime for authorization codes (seconds)
OAUTH_AUTH_CODE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
# Comma-separated frame ancestors allowed to embed the auth UI
CSP_FRAME_ANCESTORS='none'
HSTS_MAX_AGE=31536000
