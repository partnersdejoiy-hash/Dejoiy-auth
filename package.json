{
  "name": "dejoiy-auth",
  "version": "0.1.0",
  "private": true,
  "description": "DEJOIY AUTH — enterprise self-hosted centralized identity and access platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @dejoiy/api test",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @dejoiy/api db:migrate",
    "db:seed": "pnpm --filter @dejoiy/api db:seed",
    "bootstrap": "pnpm --filter @dejoiy/api bootstrap",
    "dev:api": "pnpm --filter @dejoiy/api dev",
    "dev:web": "pnpm --filter @dejoiy/web dev"
  }
}
